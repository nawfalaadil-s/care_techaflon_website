# Production environment template — copy to .env and fill every value.
# Never commit the real .env file.

# Application
APP_NAME="TechAFlon API"
APP_VERSION=0.1.0
ENVIRONMENT=production
DEBUG=false

# Database — hosted PostgreSQL (e.g. Supabase/managed Postgres).
# URL-encode special characters in the password (@ -> %40).
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME

# Security — REQUIRED: a strong random value (the app refuses to boot in
# production without one). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — exact origins allowed to call the API (no trailing slashes).
CORS_ORIGINS=["https://techaflon.example.com"]

# Email — automatic mail delivery.
# Transports are tried in order: Gmail API -> SMTP -> log mode (record only).
#
# Gmail over SMTP: enable 2-Step Verification, create an App Password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASSWORD.
EMAIL_ENABLED=true
EMAIL_FROM="TechAFlon <no-reply@yourdomain.edu>"

# Transport 1: Gmail API via Google OAuth 2.0.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Transport 2: generic SMTP / Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=no-reply@yourdomain.edu
SMTP_PASSWORD=
SMTP_USE_TLS=true
