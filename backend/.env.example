# Application
APP_NAME="Hackathon Platform API"
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/hackathon

# Security (used from the authentication phase onward)
SECRET_KEY=change-me-in-production

# CORS (comma-separated list is also accepted)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ---------------------------------------------------------------------------
# Email — automatic mail delivery
# ---------------------------------------------------------------------------
# Transports are tried in order: Gmail API -> SMTP -> log mode (record only).

EMAIL_ENABLED=true
EMAIL_FROM="TechAFlon <your.sender@gmail.com>"

# Transport 1: Gmail API (Google OAuth 2.0 refresh token).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Transport 2: Gmail over SMTP.
# 1. Enable 2-Step Verification on the Google account.
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. SMTP_PASSWORD = the 16-character App Password (NOT the login password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.sender@gmail.com
SMTP_PASSWORD=
SMTP_USE_TLS=true

# ---------------------------------------------------------------------------
# Mailjet — transactional email over HTTPS (recommended for Render free tier,
# which blocks outbound SMTP ports but allows HTTPS 443).
# ---------------------------------------------------------------------------
# Dashboard: https://app.mailjet.com -> Account -> API Keys (key pair).
# HTTP Basic auth (API Key : Secret Key). Set EMAIL_FROM to a sender you
# have validated in Mailjet (Account Senders & Domains), e.g. techaflon@gmail.com.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
